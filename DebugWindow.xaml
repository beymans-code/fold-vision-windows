<Window x:Class="FoldVision.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoldVision — Debug" Height="160" Width="380"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Simular ángulo de bisagra" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Text="90° = abierta (sin efecto)   →   175° = cerrada (blur máximo)"
                   Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>
        <Slider x:Name="AngleSlider" Minimum="90" Maximum="175" Value="90"
                ValueChanged="AngleSlider_ValueChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Ángulo actual: " />
            <TextBlock Text="{Binding ElementName=AngleSlider, Path=Value, StringFormat={}{0:F0}°}"
                       FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
