<ui:FluentWindow x:Class="FoldVision.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource SettingsWinTitle}" Height="830" Width="440"
        Topmost="True" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="440"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Background="Transparent" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar Title="{DynamicResource SettingsWinTitle}" Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,12,24,24">
                <TextBlock Text="{DynamicResource SettingsHeader}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <Separator Margin="0,0,0,4"/>
            
            <!-- Idioma -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LanguageHeader}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="Language_Changed" Width="100">
                    <ComboBoxItem Content="{DynamicResource LangSpanish}" Tag="es"/>
                    <ComboBoxItem Content="{DynamicResource LangEnglish}" Tag="en"/>
                </ComboBox>
            </Grid>
            <Separator Margin="0,0,0,4"/>

            <!-- Profundidad de perspectiva -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource PerspectiveDepth}"/>
                <TextBlock x:Name="DepthValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="DepthSlider" Minimum="0.5" Maximum="5.0" SmallChange="0.1" LargeChange="0.5"
                    ValueChanged="DepthSlider_Changed"/>

            <!-- Altura máxima (stretchMult) -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource MaxImageHeight}"/>
                <TextBlock x:Name="StretchValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="StretchSlider" Minimum="0.0" Maximum="4.0" SmallChange="0.1" LargeChange="0.5"
                    ValueChanged="StretchSlider_Changed"/>

            <!-- Nivel de blur -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource BlurIntensity}"/>
                <TextBlock x:Name="BlurValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="BlurSlider" Minimum="0.0" Maximum="2.5" SmallChange="0.05" LargeChange="0.25"
                    ValueChanged="BlurSlider_Changed"/>

            <!-- Radio de esquinas superiores -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource CornerRadius}"/>
                <TextBlock x:Name="CornerValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="CornerSlider" Minimum="0" Maximum="80" SmallChange="1" LargeChange="5"
                    ValueChanged="CornerSlider_Changed"/>

            <!-- Radio inicial de esquinas superiores -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource CornerStartRadius}"/>
                <TextBlock x:Name="CornerStartValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="CornerStartSlider" Minimum="0" Maximum="80" SmallChange="1" LargeChange="5"
                    ValueChanged="CornerStartSlider_Changed"/>

            <!-- Altura máxima de la máscara -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ClipHeight}"/>
                <TextBlock x:Name="ClipHeightValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="ClipHeightSlider" Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                    ValueChanged="ClipHeightSlider_Changed"/>

            <!-- Rango de animación del radio -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource CornerAnimRange}"/>
                <TextBlock x:Name="CornerAnimValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="CornerAnimSlider" Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                    ValueChanged="CornerAnimSlider_Changed"/>

            <!-- Inicio de desvanecimiento (opacidad) -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource OpacityAnimStart}"/>
                <TextBlock x:Name="OpacityAnimValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="OpacityAnimSlider" Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                    ValueChanged="OpacityAnimSlider_Changed"/>

            <!-- Rango de activación -->
            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource AngleStart}"/>
                <TextBlock x:Name="AngleStartValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="AngleStartSlider" Minimum="60" Maximum="130" SmallChange="1" LargeChange="5"
                    ValueChanged="AngleStart_Changed"/>

            <Grid Margin="0,14,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource AngleMax}"/>
                <TextBlock x:Name="AngleMaxValue" Grid.Column="1" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="AngleMaxSlider" Minimum="100" Maximum="180" SmallChange="1" LargeChange="5"
                    ValueChanged="AngleMax_Changed"/>

            <!-- Modo de la aplicación -->
            <TextBlock Text="{DynamicResource CaptureMode}" Margin="0,16,0,4"/>
            <ComboBox x:Name="AppModeCombo" SelectionChanged="AppMode_Changed" Margin="0,0,0,16" HorizontalAlignment="Left" Width="150">
                <ComboBoxItem Content="{DynamicResource CaptureModeStatic}"/>
                <ComboBoxItem Content="{DynamicResource CaptureModeLive}"/>
            </ComboBox>

            <ui:ToggleSwitch x:Name="chkTabletMode" Content="{DynamicResource DisableTabletMode}" 
                             Checked="TabletMode_Changed" Unchecked="TabletMode_Changed" Margin="0,8,0,0"/>

            <ui:ToggleSwitch x:Name="AutoStartCheckBox" Content="{DynamicResource AutoStart}" 
                             Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" Margin="0,8,0,0"/>
            
            <ui:ToggleSwitch x:Name="ShowDebugCheckBox" Content="{DynamicResource ShowOSD}" 
                             Checked="ShowDebug_Changed" Unchecked="ShowDebug_Changed" Margin="0,8,0,0"/>

            <!-- Botones inferiores -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button x:Name="UninstallBtn" Content="{DynamicResource UninstallButton}" Margin="0,0,10,0" Padding="12,6"
                           Click="Uninstall_Click" Appearance="Danger"/>
                <ui:Button Content="{DynamicResource ResetDefaults}" Padding="12,6"
                           Click="Reset_Click" Appearance="Secondary"/>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
