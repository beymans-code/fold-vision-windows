<Window x:Class="FoldVision.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWinTitle}" Height="650" Width="440"
        Topmost="True" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="White" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#89B4FA"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource SettingsHeader}" FontSize="16" FontWeight="Bold"
                   Foreground="#CBA6F7" Margin="0,0,0,8"/>
        <Separator Background="#313244" Margin="0,0,0,4"/>
        
        <!-- Idioma -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource LanguageHeader}" Margin="0,4,0,0"/>
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="Language_Changed" 
                      Background="#1E1E2E" Foreground="Black" Width="100">
                <ComboBoxItem Content="{DynamicResource LangSpanish}" Tag="es"/>
                <ComboBoxItem Content="{DynamicResource LangEnglish}" Tag="en"/>
            </ComboBox>
        </Grid>
        <Separator Background="#313244" Margin="0,0,0,4"/>

        <!-- Profundidad de perspectiva -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource PerspectiveDepth}"/>
            <TextBlock x:Name="DepthValue" Grid.Column="1" Style="{StaticResource Value}" VerticalAlignment="Bottom" Margin="0,14,0,2"/>
        </Grid>
        <Slider x:Name="DepthSlider" Minimum="0.5" Maximum="5.0" SmallChange="0.1" LargeChange="0.5"
                ValueChanged="DepthSlider_Changed"/>

        <!-- Altura máxima (stretchMult) -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource MaxImageHeight}"/>
            <TextBlock x:Name="StretchValue" Grid.Column="1" Style="{StaticResource Value}" VerticalAlignment="Bottom" Margin="0,14,0,2"/>
        </Grid>
        <Slider x:Name="StretchSlider" Minimum="0.0" Maximum="4.0" SmallChange="0.1" LargeChange="0.5"
                ValueChanged="StretchSlider_Changed"/>

        <!-- Nivel de blur -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource BlurIntensity}"/>
            <TextBlock x:Name="BlurValue" Grid.Column="1" Style="{StaticResource Value}" VerticalAlignment="Bottom" Margin="0,14,0,2"/>
        </Grid>
        <Slider x:Name="BlurSlider" Minimum="0.0" Maximum="2.5" SmallChange="0.05" LargeChange="0.25"
                ValueChanged="BlurSlider_Changed"/>

        <!-- Rango de activación -->
        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource AngleStart}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Slider x:Name="AngleStartSlider" Minimum="60" Maximum="130" SmallChange="1" LargeChange="5"
                    ValueChanged="AngleStart_Changed"/>
            <TextBlock x:Name="AngleStartValue" Grid.Column="1" Style="{StaticResource Value}" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource AngleMax}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Slider x:Name="AngleMaxSlider" Minimum="100" Maximum="180" SmallChange="1" LargeChange="5"
                    ValueChanged="AngleMax_Changed"/>
            <TextBlock x:Name="AngleMaxValue" Grid.Column="1" Style="{StaticResource Value}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Modo de la aplicación -->
        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource CaptureMode}" Margin="0,16,0,4"/>
        <ComboBox x:Name="AppModeCombo" SelectionChanged="AppMode_Changed" 
                  Background="#1E1E2E" Foreground="Black" Margin="0,0,0,16">
            <ComboBoxItem Content="{DynamicResource CaptureModeStatic}"/>
            <ComboBoxItem Content="{DynamicResource CaptureModeLive}"/>
        </ComboBox>

        <CheckBox x:Name="chkTabletMode" Content="{DynamicResource DisableTabletMode}" 
                  Foreground="#CDD6F4" Checked="TabletMode_Changed" Unchecked="TabletMode_Changed"/>

        <CheckBox x:Name="AutoStartCheckBox" Content="{DynamicResource AutoStart}" 
                  Foreground="#CDD6F4" Margin="0,8,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
        
        <CheckBox x:Name="ShowDebugCheckBox" Content="{DynamicResource ShowOSD}" 
                  Foreground="#CDD6F4" Margin="0,8,0,0" Checked="ShowDebug_Changed" Unchecked="ShowDebug_Changed"/>

        <!-- Botones inferiores -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="UninstallBtn" Content="{DynamicResource UninstallButton}" Margin="0,0,10,0" Padding="12,6"
                    Click="Uninstall_Click"
                    Background="#313244" Foreground="#F38BA8" BorderBrush="#45475A"/>
            <Button Content="{DynamicResource ResetDefaults}" Padding="12,6"
                    Click="Reset_Click"
                    Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"/>
        </StackPanel>
    </StackPanel>
</Window>
